    {
      "parameters": {
        "jsCode": "const raw = String($json.output ?? '');\nconst match = raw.match(/ROUTE_CODE:\\s*(STANDARD|RESERVATION|EVENT|HUMAN)/i);\nconst routeCode = match ? match[1].toUpperCase() : 'STANDARD';\nconst customerResponse = raw\n  .replace(/\\n?ROUTE_CODE:\\s*(STANDARD|RESERVATION|EVENT|HUMAN)\\s*$/i, '')\n  .trim();\nreturn [{\n  json: {\n    ...$json,\n    route_code: routeCode,\n    customer_response: customerResponse\n  }\n}];"
      },
