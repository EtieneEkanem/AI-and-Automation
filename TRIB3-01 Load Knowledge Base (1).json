      "parameters": {
        "public": true,
        "initialMessages": "Hi there! 👋\n welcome to TRIB3 Lagos. I can help with opening hours, location, selected \nmenu options, reservation enquiries, events, photoshoots and guest support. How may I assist you?",
        "options": {
          "allowedOrigins": "https://37e20992-40e9-4581-b70e-79f6fc377d7a.lovableproject.com,https://trib3-chat-concierge.lovable.app",
